# Copy to .env.local for local runs (never commit .env.local).
# Both values are public by design: Row Level Security protects the data, and the role
# in the JWT (set by the custom access token hook) decides who can write.

# Supabase project URL. Dashboard > Project Settings > Data API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (sb_publishable_...). Dashboard > Project Settings > API Keys.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
