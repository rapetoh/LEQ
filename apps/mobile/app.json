{
  "expo": {
    "name": "LEQ",
    "slug": "leq",
    "version": "0.1.0",
    "scheme": "leq",
    "orientation": "portrait",
    "icon": "./assets/marque/icone.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.leqapp.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Pour analyser ta prise de parole. L'enregistrement est effacé après l'analyse.",
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": ["fr", "fr"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "buildNumber": "34"
    },
    "android": {
      "package": "com.leqapp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#001636",
        "foregroundImage": "./assets/marque/icone.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#001636",
          "image": null
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "iosMicrophonePermission": "Pour analyser ta prise de parole. L'enregistrement est effacé après l'analyse.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MICROPHONE"
          ],
          "androidForegroundService": true,
          "androidFSTypes": ["microphone"]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#001636"
        }
      ],
      "expo-localization",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.857353590307-o4m8tts8r2a2g6h6ti9nu65g88b3031j"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour choisir ta photo de profil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "705674fb-72ee-426c-ae36-9dabc28601f1"
      }
    },
    "owner": "rxpetoh"
  }
}
