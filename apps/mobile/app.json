{
  "expo": {
    "name": "LEQ",
    "slug": "leq",
    "version": "0.1.0",
    "scheme": "leq",
    "orientation": "portrait",
    "icon": "./assets/marque/icone.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.leqapp.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "LEQ a besoin du micro pour analyser ta prise de parole. Ta voix est analysée puis effacée.",
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": ["fr", "fr"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.leqapp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#001636",
        "foregroundImage": "./assets/marque/icone.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#001636",
          "image": "./assets/marque/sigle-blanc.png",
          "imageWidth": 220
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "iosMicrophonePermission": "LEQ a besoin du micro pour analyser ta prise de parole. Ta voix est analysée puis effacée.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MICROPHONE"
          ],
          "androidForegroundService": true,
          "androidFSTypes": ["microphone"]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#001636"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "705674fb-72ee-426c-ae36-9dabc28601f1"
      }
    },
    "owner": "rxpetoh"
  }
}
