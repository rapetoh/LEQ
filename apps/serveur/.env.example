# Copy to .env for local runs (never commit .env). Every variable is read once at startup by src/config.ts.
# Empty values are treated as unset, so a default applies.

# Direct Postgres connection (not the pooler): the worker uses FOR UPDATE SKIP LOCKED and transactions.
# Supabase dashboard > Connect > Direct connection.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase project URL and the secret (service role) API key. The key bypasses RLS; it lives only on the server.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Which process this instance runs: "worker" (jobs, analysis pipeline) or "temps-reel" (debate WebSocket, Phase 8).
# On Fly.io this falls back to FLY_PROCESS_GROUP when unset.
PROCESS=worker

# Identifier written into jobs.verrouille_par. Defaults to "<hostname>-<pid>".
WORKER_ID=

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# HTTP port for /sante and /debat. Fly's http_service targets 8080.
PORT=8080

# Speech-to-text provider for a recorded take: "stub" (deterministic, for tests) or "openai"
# (Whisper, word timings). Production runs "openai" since 2026-09-13 (ADR-011).
TRANSCRIPTEUR=stub

# Paths to external binaries. Defaults work inside the Docker image.
FFMPEG_PATH=ffmpeg
PYTHON_PATH=python3
# Absolute path to prosodie/extraire.py. Defaults to the file shipped next to this package.
PROSODIE_SCRIPT=

# Idle sleep of the worker loop between two empty claims, in milliseconds.
INTERVALLE_INACTIF_MS=2000

# Timeout for one external tool call (ffmpeg, the Praat CLI), in milliseconds.
DELAI_OUTIL_MS=120000

# Face-à-face (Phase 8): the live transcriber, Rétor, and Rétor's voice. "stub" or "openai".
TRANSCRIPTEUR_FLUX=stub
ADVERSAIRE=stub
VOIX=stub

# The judge of the two judged axes of the note and of the remarks outside the grid (chapter 5):
# "aucun" (the note carries the measured axes only) or "openai".
JUGE=aucun

# One key for every "openai" above. Server secret only, set with `fly secrets set` in production.
OPENAI_API_KEY=
